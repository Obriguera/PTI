# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_DB=pti
POSTGRES_USER=pti
POSTGRES_PASSWORD=changeme   # cambiar antes de levantar

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── FastAPI ───────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-generar-con-openssl-rand-hex-32
DEBUG=true

# ── Google Earth Engine (cuenta académica) ────────────────────────────────────
GEE_SERVICE_ACCOUNT=
GEE_CREDENTIALS_PATH=/run/secrets/gee_key.json

# ── NASA EarthData (para SMAP L4) ─────────────────────────────────────────────
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── Open-Meteo / NASA POWER ───────────────────────────────────────────────────
# No requieren API key en el tier gratuito

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
